# Copie este arquivo para ".env" (na mesma pasta) e preencha.
# O arquivo ".env" real NUNCA deve ser enviado ao GitHub.

DB_NAME=gestao_escolar
DB_USER=postgres
DB_PASSWORD=coloque-a-senha-do-seu-postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Gere uma chave nova com:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=True
# Em produção/nuvem: domínios separados por vírgula (ex.: meusite.com,www.meusite.com)
DJANGO_ALLOWED_HOSTS=
